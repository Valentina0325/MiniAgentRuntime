# ============================================================
# MiniAgentRuntime 环境变量示例
# 复制本文件为 .env 并填入真实值：  cp .env.example .env
# ============================================================

# 智谱 AI 的 OpenAI 兼容接口 Key（必填，用于驱动 LLM 主循环）
ZHIPU_API_KEY=your-zhipu-api-key-here

# 使用的模型（可选，默认 glm-4-flash；如需更强能力可改为 glm-4 / glm-4-plus）
ZHIPU_MODEL=glm-4-flash

# 智谱 OpenAI 兼容端点（可选，默认如下）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# AgentLens 可观测后端地址（可选，默认 http://localhost:8000）
AGENTLENS_BASE=http://localhost:8000
